@startuml 高校电竞约赛平台类图

' 样式设置
skinparam class {
    BackgroundColor #F5F5F5
    BorderColor #333333
}

' 用户实体
class 用户 {
    +Long 编号
    +String 用户名
    +String 密码
    +String 昵称
    +String 头像
    +String 学校
    +String 角色
    +String 邮箱
    +LocalDateTime 创建时间
    +LocalDateTime 更新时间
    
    +注册()
    +登录()
    +更新资料()
    +获取战队()
    +获取赛事()
}

' 战队实体
class 战队 {
    +Long 编号
    +String 名称
    +String 队标
    +String 学校
    +String 游戏项目
    +String 简介
    +Long 队长编号
    +Integer 成员数
    +LocalDateTime 创建时间
    +Integer 状态
    
    +创建战队()
    +更新战队()
    +加入战队()
    +退出战队()
    +获取成员()
}

' 战队成员关系
class 战队成员 {
    +Long 编号
    +Long 战队编号
    +Long 用户编号
    +String 角色
    +LocalDateTime 加入时间
    
    +添加成员()
    +移除成员()
    +更新角色()
}

' 赛事实体
class 赛事 {
    +Long 编号
    +String 名称
    +String 游戏项目
    +String 学校
    +LocalDateTime 开始时间
    +LocalDateTime 结束时间
    +String 状态
    +Integer 最大战队数
    +String 赛事类型
    
    +创建赛事()
    +更新赛事()
    +报名参赛()
    +开始赛事()
    +结束赛事()
}

' 赛事报名
class 赛事报名 {
    +Long 编号
    +Long 赛事编号
    +Long 战队编号
    +Integer 状态
    +LocalDateTime 报名时间
    
    +报名赛事()
    +审核报名()
    +取消报名()
}

' 社区帖子
class 帖子 {
    +Long 编号
    +String 标题
    +String 内容
    +String 游戏项目
    +String 学校
    +Long 用户编号
    +Integer 点赞数
    +Integer 评论数
    +Integer 状态
    +LocalDateTime 创建时间
    +LocalDateTime 更新时间
    
    +发布帖子()
    +更新帖子()
    +删除帖子()
    +点赞帖子()
    +获取评论()
}

' 评论
class 评论 {
    +Long 编号
    +Long 帖子编号
    +Long 用户编号
    +String 内容
    +LocalDateTime 创建时间
    
    +发布评论()
    +更新评论()
    +删除评论()
}

' 公告
class 公告 {
    +Long 编号
    +String 标题
    +String 内容
    +String 类型
    +Integer 状态
    +LocalDateTime 创建时间
    
    +发布公告()
    +更新公告()
    +删除公告()
}

' 新闻
class 新闻 {
    +Long 编号
    +String 标题
    +String 内容
    +String 封面
    +String 分类
    +Integer 状态
    +LocalDateTime 创建时间
    
    +发布新闻()
    +更新新闻()
    +删除新闻()
}

' 消息
class 消息 {
    +Long 编号
    +Long 发送者编号
    +Long 接收者编号
    +String 内容
    +Integer 状态
    +LocalDateTime 发送时间
    +LocalDateTime 阅读时间
    
    +发送消息()
    +阅读消息()
    +删除消息()
}

' 比赛结果
class 比赛结果 {
    +Long 编号
    +Long 赛事编号
    +Long 战队编号
    +Integer 比分
    +Boolean 是否获胜
    +LocalDateTime 创建时间
    
    +提交结果()
    +确认结果()
    +申诉结果()
}

' 商业合作伙伴
class 合作伙伴 {
    +Long 编号
    +String 名称
    +String 联系人
    +String 电话
    +String 邮箱
    +String 类型
    +Integer 状态
    +LocalDateTime 创建时间
    
    +创建合作()
    +更新合作()
    +删除合作()
}

' 订单
class 订单 {
    +Long 编号
    +Long 用户编号
    +Long 产品编号
    +String 产品类型
    +Double 金额
    +String 状态
    +LocalDateTime 创建时间
    +LocalDateTime 支付时间
    
    +创建订单()
    +支付订单()
    +取消订单()
    +退款订单()
}

' 关系定义
' 用户与战队（聚合关系）
用户 o-- 战队 : 创建/加入

' 用户与帖子（关联关系）
用户 -- 帖子 : 发布

' 用户与评论（关联关系）
用户 -- 评论 : 评论

' 用户与消息（关联关系）
用户 -- 消息 : 发送/接收

' 用户与订单（关联关系）
用户 -- 订单 : 下单

' 战队与成员（组合关系）
战队 *-- 战队成员 : 包含

' 战队与赛事报名（关联关系）
战队 -- 赛事报名 : 报名

' 战队与比赛结果（关联关系）
战队 -- 比赛结果 : 参赛

' 赛事与报名（组合关系）
赛事 *-- 赛事报名 : 报名记录

' 赛事与结果（组合关系）
赛事 *-- 比赛结果 : 比赛结果

' 帖子与评论（组合关系）
帖子 *-- 评论 : 包含

' 赞助商与赛事（关联关系）
合作伙伴 -- 赛事 : 赞助

@enduml